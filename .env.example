# ---- Live actions gate ----
# 0 (default) = customer notifications are SIMULATED (no real WhatsApp/email).
# 1 = notify_customer really sends via Twilio/Resend. The console toggle
# overrides this per-run. DB mutations are always local and safe.
LIVE_ACTIONS=0

# ---- Human-oversight approval gate ----
# Financial actions (issue_credit) at/above this USD limit require human approval.
APPROVAL_THRESHOLD_USD=100
# 1 = BLOCK such actions (status "awaiting_human_approval", no mutation) until sign-off.
# 0 (default) = surface require_approval but auto-approve so the demo flow completes.
REQUIRE_APPROVAL=0

# ---- Core LLM ----
# Model overrides (defaults work out of the box):
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Search ----
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ---- Messaging ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sandbox sender is usually whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ---- Email ----
RESEND_API_KEY=
RESEND_FROM=

# ---- RAG (optional Chroma Cloud; blank = in-memory) ----
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
