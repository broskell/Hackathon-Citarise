# ---- Live actions gate ----
# 0 (default) = customer notifications are SIMULATED (no real WhatsApp/email).
# 1 = notify_customer really sends via Twilio/Resend. The console toggle
# overrides this per-run. DB mutations are always local and safe.
LIVE_ACTIONS=0
# When LIVE, route real sends to a verified recipient you control (the demo
# customers use fake @example.com / test numbers that providers reject).
DEMO_EMAIL=
DEMO_WHATSAPP=

# ---- Human-oversight approval gate ----
# Financial actions (issue_credit) at/above this USD limit require human approval.
APPROVAL_THRESHOLD_USD=100
# 1 = BLOCK such actions (status "awaiting_human_approval", no mutation) until sign-off.
# 0 (default) = surface require_approval but auto-approve so the demo flow completes.
REQUIRE_APPROVAL=0

# ---- Core LLM (required for the agent planner) ----
GEMINI_API_KEY=
GROQ_API_KEY=
# Model overrides (defaults work out of the box). Note: gpt-oss-20b has a
# separate daily-token bucket from 120b -- handy if one caps out.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b

# ---- Messaging (only needed for LIVE customer notifications) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sandbox sender is usually whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
RESEND_FROM=
